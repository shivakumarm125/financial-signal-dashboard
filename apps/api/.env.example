# Supabase Postgres connection string (Settings -> Database -> Connection string -> URI)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Required by SEC EDGAR's fair-access policy on every automated request.
# Format: "Name contact@email.com" -- must be a real, reachable contact.
EDGAR_USER_AGENT="Shiva shiva.study.kumar@gmail.com"

# Free tier: 8 requests/minute, 800/day. Very limited -- B2's ingestion is designed
# to use exactly 1 request per ticker per sync (backfill or incremental alike).
TWELVE_DATA_API_KEY="your-key-here"

# Free tier: 60 requests/minute -- much more generous than Twelve Data, but
# B3 still throttles to be a good citizen.
FINNHUB_API_KEY="your-key-here"
