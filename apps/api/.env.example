# Easiest: run `npm run setup` from the repo root. It asks for each value,
# checks it works, and writes this file as apps/api/.env for you.

# Postgres connection string. With Supabase: Connect -> "Session pooler" (port 5432).
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Required by SEC EDGAR's fair-access policy on every automated request.
# Format: "Name contact@email.com" -- must be a real, reachable contact.
EDGAR_USER_AGENT="Your Name you@example.com"

# twelvedata.com free plan: 8 requests/minute, 800/day. Ingestion uses exactly
# 1 request per stock per update.
TWELVE_DATA_API_KEY="your-key-here"

# finnhub.io free plan: 60 requests/minute.
FINNHUB_API_KEY="your-key-here"

# Optional. With a key, Claude makes each call and writes the reasoning
# (about $0.01-0.02 per stock per update, via the half-price Batch API).
# Leave it empty to use the free rules engine instead.
CLAUDE_API_KEY=""

# StockTwits' public API needs no key; only the User-Agent is configurable.
# Used on the non-commercial-use assumption in docs/A3-disclaimer-data-use.md.
STOCKTWITS_USER_AGENT="stock-signals/0.1 (self-hosted research dashboard)"
