# Written for you by `npm run setup` as apps/web/.env.local.

# The same database, through Supabase's TRANSACTION pooler (port 6543) with one
# connection per function -- the session pooler runs out of clients on serverless.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Password for the /manage page, where stocks are added and removed.
MANAGE_PASSWORD="choose-something-long"
