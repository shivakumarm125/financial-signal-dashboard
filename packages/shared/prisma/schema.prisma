generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per publicly traded ticker we track. Shared across all users —
// ingestion runs once per ticker, not once per (user, ticker) pair, since
// this data (price/filings/news/social) is identical regardless of who's watching.
model Ticker {
  id        String   @id @default(uuid())
  symbol    String   @unique
  cik       String?  @unique // SEC's 10-digit zero-padded CIK; null until resolved via company_tickers.json
  name      String?
  exchange  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  insiderFilings      InsiderFiling[]
  filingIngestionState FilingIngestionState?
  priceBars           PriceBar[]
  priceIngestionState PriceIngestionState?
  newsArticles        NewsArticle[]
  newsIngestionState  NewsIngestionState?
  earningsEvents      EarningsEvent[]
  socialPosts         SocialPost[]
  socialIngestionState SocialIngestionState?
  usageRecords        UsageRecord[]
  signalRecords       SignalRecord[]
  backtestSignals     BacktestSignal[]

  @@map("tickers")
}

// Tracks incremental-sync state per ticker for the EDGAR Form 4 ingestion job (B1),
// so each run only asks EDGAR for filings newer than the last one already processed.
model FilingIngestionState {
  id                     String   @id @default(uuid())
  ticker                 Ticker   @relation(fields: [tickerId], references: [id])
  tickerId               String   @unique
  lastAccessionNumber    String?
  lastFilingDate         DateTime?
  updatedAt              DateTime @updatedAt

  @@map("filing_ingestion_state")
}

// One row per insider transaction line item parsed out of a Form 4 (or Form 4/A) filing.
// A single filing can contain multiple transactions, so the natural unique key is
// (accessionNumber, transactionIndex) rather than accessionNumber alone.
model InsiderFiling {
  id                String   @id @default(uuid())
  ticker            Ticker   @relation(fields: [tickerId], references: [id])
  tickerId          String

  accessionNumber   String   // SEC accession number for the source filing, e.g. "0001234567-26-000123"
  transactionIndex  Int      // position of this transaction within the filing (0-based)
  isAmendment       Boolean  @default(false) // true for Form 4/A; stored as an independent record, not linked to the original (documented MVP simplification)

  insiderName       String
  insiderIsDirector Boolean  @default(false)
  insiderIsOfficer  Boolean  @default(false)
  insiderOfficerTitle String?
  insiderIsTenPercentOwner Boolean @default(false)

  transactionCode   String   // SEC transaction code, e.g. "P" (purchase), "S" (sale)
  transactionDate   DateTime
  sharesTransacted  Decimal  @db.Decimal(20, 4)
  pricePerShare     Decimal? @db.Decimal(20, 4)

  filedAt           DateTime // filing date from EDGAR submissions data
  createdAt         DateTime @default(now())

  @@unique([accessionNumber, transactionIndex])
  @@index([tickerId, transactionDate])
  @@map("insider_filings")
}

// One row per daily OHLCV bar per ticker (B2). Twelve Data, daily interval only —
// this product is scheduled/batch by design (A1), never intraday.
model PriceBar {
  id       String   @id @default(uuid())
  ticker   Ticker   @relation(fields: [tickerId], references: [id])
  tickerId String

  date   DateTime // calendar date of the bar, no time component
  open   Decimal  @db.Decimal(20, 4)
  high   Decimal  @db.Decimal(20, 4)
  low    Decimal  @db.Decimal(20, 4)
  close  Decimal  @db.Decimal(20, 4)
  volume BigInt

  createdAt DateTime @default(now())

  @@unique([tickerId, date])
  @@index([tickerId, date])
  @@map("price_bars")
}

// Tracks incremental-sync state per ticker for the price ingestion job (B2), so
// each run only requests bars newer than the last one already stored — the same
// pattern as FilingIngestionState, doubly important here given Twelve Data's tight
// free-tier quota (8 req/min, 800/day).
model PriceIngestionState {
  id          String    @id @default(uuid())
  ticker      Ticker    @relation(fields: [tickerId], references: [id])
  tickerId    String    @unique
  lastBarDate DateTime?
  updatedAt   DateTime  @updatedAt

  @@map("price_ingestion_state")
}

// One row per news article per ticker (B3). Finnhub only for MVP (NewsAPI
// fallback dropped -- its rationale was thin India coverage, and India is out
// of scope entirely now). Passed raw to Claude per A5, no sentiment pre-tagging.
model NewsArticle {
  id       String @id @default(uuid())
  ticker   Ticker @relation(fields: [tickerId], references: [id])
  tickerId String

  externalId  String // Finnhub's own article id, stringified
  source      String
  headline    String
  summary     String?
  url         String
  publishedAt DateTime

  createdAt DateTime @default(now())

  @@unique([tickerId, externalId])
  @@index([tickerId, publishedAt])
  @@map("news_articles")
}

// One row per pipeline run (D4, added 2026-08-02). Exists because the job runs
// unattended, spends real money, and previously had no record of itself: the
// only way to notice a failure was to spot stale signals days later.
//
// A green workflow is NOT proof the run worked. run-all.ts continues past a
// single ticker's failed signal by design (one bad ticker shouldn't kill the
// others), so a run can generate zero signals and still exit 0. That is what
// `status: "partial"` captures and what the dashboard banner surfaces.
model PipelineRun {
  id String @id @default(uuid())

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  // "running" | "success" | "partial" | "failed"
  status  String  @default("running")
  trigger String? // "schedule" | "manual" | "local" -- from GITHUB_EVENT_NAME where available

  tickersAttempted Int @default(0)
  signalsGenerated Int @default(0)
  signalsFailed    Int @default(0)
  ingestionErrors  Int @default(0)
  outcomesUpdated  Int @default(0)

  detail String? // human-readable summary of what actually went wrong

  @@index([startedAt])
  @@map("pipeline_runs")
}

// Social/forum speculation (B4) -- the fourth data source from A1, and the one
// every signal rationale has been reporting as missing since C1 shipped.
//
// VENDOR: StockTwits, not Reddit. A2 originally picked Reddit and flagged that
// its API terms were tightening; that risk materialised on 2026-08-02, when
// Reddit's app creation became gated behind a Responsible Builder Policy review
// that blocks self-serve access. StockTwits' public API needs no registration,
// is cashtag-native (every message is tied to a symbol rather than found by
// keyword search), and exposes real author reputation. A2/A3 updated to match.
//
// A3's tracked non-commercial-use assumption carries over to StockTwits
// unchanged in substance: a small, free, invite-only tool, not formally legally
// verified, to be re-checked if this ever takes on billing or grows.
//
// `isUnverified` is hardcoded true and never written as anything else. A1 and
// A3 both require social content to be labelled unverified speculation rather
// than fact, and a column that is structurally always true is harder to
// accidentally violate than a convention someone has to remember.
model SocialPost {
  id       String @id @default(uuid())
  ticker   Ticker @relation(fields: [tickerId], references: [id])
  tickerId String

  externalId String // StockTwits message id, stringified
  platform   String @default("stocktwits")
  author     String?

  // Author reputation, captured at ingest. These are what make the credibility
  // score mean something: followers and account age are standing reputation,
  // unlike upvotes on a single post, which only measure one post's traction.
  authorFollowers Int?
  authorPostCount Int?
  authorJoinedAt  DateTime?
  authorOfficial  Boolean @default(false)

  body String
  url  String

  /// The poster's OWN Bullish/Bearish tag where they set one. Self-declared, so
  /// it says what they claim to believe -- never that they are right.
  declaredSentiment String?

  postedAt DateTime

  /// 0-100. See scoreCredibility() -- measures the AUTHOR'S STANDING on the
  /// platform, NOT whether their claim is true. Nothing observable about a post
  /// establishes accuracy; a widely-followed account can be confidently wrong.
  /// The prompt says so explicitly.
  credibilityScore Int
  /// Human-readable breakdown of how the score above was reached.
  credibilityBasis String
  /// Always true. Never set to false.
  isUnverified Boolean @default(true)

  createdAt DateTime @default(now())

  @@unique([tickerId, externalId])
  @@index([tickerId, postedAt])
  @@map("social_posts")
}

// Tracks incremental-sync state per ticker for social ingestion (B4).
model SocialIngestionState {
  id       String @id @default(uuid())
  ticker   Ticker @relation(fields: [tickerId], references: [id])
  tickerId String @unique

  lastSyncedAt DateTime?
  updatedAt    DateTime  @updatedAt

  @@map("social_ingestion_state")
}

// Scheduled earnings dates (B10, added 2026-08-02). Exists because of a real,
// diagnosed failure: on 2026-07-30 the pipeline published a bullish AAPL signal
// with a $345 target and a 7-day horizon, hours before Apple reported Q3 after
// the close. The stock fell ~8% and four consecutive signals stopped out on the
// same day. The model had no way to know an earnings print was coming -- that
// is a missing INPUT, not a prompt-wording problem, and no amount of prompt
// tuning could have fixed it.
//
// Finnhub returns occasional duplicate rows for one date under different
// quarter labels, so the unique key is (tickerId, date) and later rows for a
// date overwrite earlier ones.
model EarningsEvent {
  id       String @id @default(uuid())
  ticker   Ticker @relation(fields: [tickerId], references: [id])
  tickerId String

  date    DateTime // the scheduled/actual report date
  hour    String? // "bmo" (before open), "amc" (after close), "dmh" (during hours)
  quarter Int?
  year    Int?

  epsEstimate     Decimal? @db.Decimal(20, 4)
  epsActual       Decimal? @db.Decimal(20, 4)
  revenueEstimate BigInt?
  revenueActual   BigInt?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tickerId, date])
  @@index([tickerId, date])
  @@map("earnings_events")
}

// Tracks incremental-sync state per ticker for news ingestion (B3). First run
// backfills 14 days (Q2) -- unlike price/filings, older news is never actually
// used (A5 only ever shows Claude the most recent 10 items), so there's no
// reason to backfill deep history here.
model NewsIngestionState {
  id             String    @id @default(uuid())
  ticker         Ticker    @relation(fields: [tickerId], references: [id])
  tickerId       String    @unique
  lastSyncedDate DateTime?
  updatedAt      DateTime  @updatedAt

  @@map("news_ingestion_state")
}

// Records actual token usage/cost for every real Claude call (C4). No User
// model yet (Epic E not built) -- tracked globally for now, same placeholder
// pattern as C2's single env-var API key; scoping to per-user is a later,
// mechanical change once accounts exist.
model UsageRecord {
  id     String  @id @default(uuid())
  ticker Ticker? @relation(fields: [tickerId], references: [id])
  // Nullable since 2026-08-02: recording moved into claudeClient so EVERY call
  // is counted, including ad-hoc and debugging ones that have no ticker
  // context. Dropping a real charge for want of a foreign key would defeat the
  // point of tracking cost at all.
  tickerId String?

  /// "signal" | "backtest" | "adhoc". Backtests are real spend but not live
  /// operating cost, and blending them makes the daily figure look worse than
  /// it is. A 10-point backtest is 10 calls.
  purpose String @default("signal")

  inputTokens      Int
  outputTokens     Int
  estimatedCostUsd Decimal  @db.Decimal(10, 6)
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([purpose])
  @@map("usage_records")
}

// Stores every generated signal (start of C5's storage half -- the +7-day
// accuracy comparison half needs real time to pass, so that stays open).
// confidence is the published, capped value (A5 Q15); rawConfidence is what
// Claude actually self-reported, kept for transparency/debugging.
model SignalRecord {
  id            String   @id @default(uuid())
  ticker        Ticker   @relation(fields: [tickerId], references: [id])
  tickerId      String
  direction     String
  confidence    Int
  rawConfidence Int
  rationale     String
  createdAt     DateTime @default(now())
  targetDate    DateTime // createdAt + 7 days (A5's fixed accuracy-tracking horizon)

  // Added 2026-07-19 -- deliberate scope change toward actionable trading
  // guidance (see docs/A1-mvp-scope.md, docs/A3-disclaimer-data-use.md).
  entryGuidance String?
  targetPrice   Decimal? @db.Decimal(20, 4)
  stopLossPrice Decimal? @db.Decimal(20, 4)

  // The price the signal was actually judged against, captured at generation
  // time (2026-08-02). Previously the outcome checker re-derived this from
  // whichever price bar happened to be <= createdAt, which meant the recorded
  // entry could quietly change if bars were re-ingested or revised. Storing it
  // makes the grade reproducible.
  entryPrice Decimal? @db.Decimal(20, 4)

  // Which engine made the call: "claude" (AI, needs an API key) or "rules"
  // (the free fixed checks in apps/api/src/baseline). Kept per signal so a
  // track record can never silently mix the two.
  engine String @default("claude")

  // Real outcome tracking (finishing C5, 2026-07-20). null = not yet
  // evaluated (either too early, or nothing terminal has happened yet).
  // Checked against actual daily price bars, not simulated.
  outcome        String?
  outcomeDetail  String?
  outcomeCheckedAt DateTime?

  // The market day the outcome actually resolved on -- the date a target or
  // stop was touched. Added 2026-08-02: the distinct-episode count that the
  // whole track record leans on was being derived by REGEX over outcomeDetail,
  // which is prose. That worked because we write the string ourselves, but it
  // made a headline statistic depend on a sentence's wording.
  outcomeResolvedOn DateTime?

  citations SignalCitation[]

  @@index([tickerId, createdAt])
  @@map("signal_records")
}

// Citations are resolved to real, durable source-record IDs at storage time --
// the short IDs Claude cites (e.g. "filing_0") are only meaningful within the
// single prompt assembly they came from (C1 Q1: freshly assigned per-prompt),
// so persisting them as-is would make a stored citation unresolvable later.
model SignalCitation {
  id             String       @id @default(uuid())
  signal         SignalRecord @relation(fields: [signalId], references: [id])
  signalId       String
  sourceType     String // "filing" | "news"
  sourceRecordId String // the real InsiderFiling.id or NewsArticle.id

  @@map("signal_citations")
}

// Backtest results (2026-07-21) -- deliberately a SEPARATE table from
// SignalRecord, not a flag on it. Keeps synthetic historical-simulation data
// from ever mixing with the live signal history, and makes wiping/re-running
// a backtest trivial without risking touching real signals. Every row here
// is fully resolved at insert time (no "pending" state) -- a backtest is
// only ever run against dates where the real subsequent outcome is already
// known history.
model BacktestSignal {
  id       String @id @default(uuid())
  ticker   Ticker @relation(fields: [tickerId], references: [id])
  tickerId String

  asOfDate      DateTime // the historical date being simulated -- not createdAt
  entryPrice    Decimal? @db.Decimal(20, 4)
  direction     String
  confidence    Int
  rawConfidence Int
  rationale     String
  entryGuidance String?
  targetPrice   Decimal? @db.Decimal(20, 4)
  stopLossPrice Decimal? @db.Decimal(20, 4)

  outcome       String
  outcomeDetail String
  /// Market day the outcome resolved on -- see SignalRecord.outcomeResolvedOn.
  outcomeResolvedOn DateTime?

  createdAt DateTime @default(now()) // when the backtest was actually run

  @@index([tickerId, asOfDate])
  @@map("backtest_signals")
}
